      },
      "targets": [
        {
          "bucketAggs": [
            { "id": "2", "type": "date_histogram", "field": "@timestamp", "settings": { "interval": "30s", "min_doc_count": "0" } }
          ],
          "datasource": { "type": "elasticsearch", "uid": "spark-elasticsearch" },
          "metrics": [
            { "id": "1", "type": "sum", "field": "metrics_worker_executors_Value" }
          ],
          "query": "_index:metrics-kubernetes-default* AND scrape_job:spark-workers AND _exists_:metrics_worker_executors_Value",
          "refId": "A",
