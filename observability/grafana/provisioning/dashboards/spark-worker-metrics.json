      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }
      },
      "targets": [
        {
          "bucketAggs": [
            { "id": "2", "type": "date_histogram", "field": "@timestamp", "settings": { "interval": "30s", "min_doc_count": "0" } }
          ],
          "datasource": { "type": "elasticsearch", "uid": "spark-elasticsearch" },
          "metrics": [
            { "id": "1", "type": "sum", "field": "metrics_worker_memUsed_MB_Value" }
          ],
          "query": "_index:metrics-kubernetes-default* AND scrape_job:spark-workers AND _exists_:metrics_worker_memUsed_MB_Value",
          "refId": "A",
          "timeField": "@timestamp",
          "alias": "used"
        },
        {
          "bucketAggs": [
            { "id": "2", "type": "date_histogram", "field": "@timestamp", "settings": { "interval": "30s", "min_doc_count": "0" } }
          ],
          "datasource": { "type": "elasticsearch", "uid": "spark-elasticsearch" },
          "metrics": [
            { "id": "1", "type": "sum", "field": "metrics_worker_memFree_MB_Value" },
            { "id": "2", "type": "bucket_script", "pipelineAgg": "1", "settings": { "script": "params._value != null ? params._value * -1 : null" } }
          ],
          "query": "_index:metrics-kubernetes-default* AND scrape_job:spark-workers AND _exists_:metrics_worker_memFree_MB_Value",
          "refId": "B",
