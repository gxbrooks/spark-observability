{
  "schemaId": "builtin:openpipeline.logs.pipelines",
  "scope": "environment",
  "value": {
    "displayName": "{{ dt_l2i_standalone_openpipeline_display_name }}",
    "customId": "{{ dt_l2i_standalone_openpipeline_custom_id }}",
    "routing": "routable",
    "groupRole": "memberPipeline",
    "processing": {
      "processors": [
        {
          "id": "tag-pipeline-custom-id",
          "type": "fieldsAdd",
          "enabled": true,
          "description": "Stamp sn-pipeline and sn-environment (dash keys for SN TBAC)",
          "matcher": "true",
          "fieldsAdd": {
            "fields": [
              {
                "name": "sn-pipeline",
                "value": "{{ dt_l2i_standalone_openpipeline_custom_id | mandatory }}"
              },
              {
                "name": "sn-environment",
                "value": "{{ dt_l2i_environment | mandatory }}"
              }
            ]
          }
        },
        {
          "id": "compose-log-instance",
          "type": "dql",
          "enabled": true,
          "description": "Compose log.instance from host.name + log.driver.instance",
          "matcher": "isNotNull(log.driver.instance)",
          "dql": {
            "script": "fieldsAdd log.instance = concat(toString(coalesce(host.name, \"unknown\")), \":\", toString(log.driver.instance))"
          }
        },
        {
          "id": "extract-log4j-class-line",
          "type": "dql",
          "enabled": true,
          "description": "Parse Class:Line; map custom-source service_instance → sn-service_instance",
          "matcher": "true",
          "dql": {
            "script": "parse content, \"TIMESTAMP('yyyy-MM-dd HH:mm:ss') SPACE{1,} WORD:log.level SPACE{1,} LD:sn_log_class ':' INT:sn_log_line LD\"\n| fieldsAdd sn_log_signature = concat(toString(coalesce(sn_log_class, \"\")), \":\", toString(coalesce(sn_log_line, \"\")))\n| fieldsAdd `sn-log-class` = sn_log_class\n| fieldsAdd `sn-log-line` = sn_log_line\n| fieldsAdd `sn-log-signature` = sn_log_signature\n| fieldsAdd `sn-service_instance` = toString(coalesce(service_instance, \"\"))"
          }
        }
      ]
    },
    "davis": {
      "processors": [
        {
          "id": "standalone-short-log4j2-warn-error-davis",
          "type": "davis",
          "enabled": true,
          "description": "Standalone short Log4j2 WARN/ERROR → ERROR_EVENT; sn-* L2I tags",
          "matcher": "(loglevel == \"WARN\" OR loglevel == \"ERROR\") AND isNotNull(`sn-log-class`) AND isNotNull(`sn-log-line`) AND isNotNull(service_instance)",
          "davis": {
            "properties": [
              { "key": "event.type", "value": "ERROR_EVENT" },
              { "key": "sn-event_kind", "value": "CRITICAL_LOG_EVENT" },
              { "key": "sn-log-class", "value": "{sn-log-class}" },
              { "key": "sn-log-line", "value": "{sn-log-line}" },
              { "key": "sn-log-signature", "value": "{sn-log-signature}" },
              { "key": "sn-environment", "value": "{sn-environment}" },
              { "key": "sn-service_instance", "value": "{sn-service_instance}" },
              { "key": "sn-pipeline", "value": "{sn-pipeline}" },
              { "key": "event.name", "value": "Critical {loglevel} at {sn-log-class}:{sn-log-line}" },
              {
                "key": "event.description",
                "value": "Standalone short Log4j2 critical {loglevel} at {sn-log-class}:{sn-log-line} in {log.path} sn-event_kind=CRITICAL_LOG_EVENT sn-log-signature={sn-log-signature} sn-environment={sn-environment} sn-service_instance={sn-service_instance} sn-pipeline={sn-pipeline}: {content}"
              },
              { "key": "dt.davis.is_merging_allowed", "value": "false" },
              {
                "key": "event.unique_identifier",
                "value": "{sn-environment}|{sn-service_instance}|Standalone Critical {loglevel} {sn-log-signature}"
              },
              { "key": "dt.davis.is_entity_remapping_allowed", "value": "false" },
              { "key": "dt.davis.event_timeout", "value": "15m" }
            ]
          }
        },
        {
          "id": "standalone-short-log4j2-missing-service-instance-davis",
          "type": "davis",
          "enabled": true,
          "description": "Fail-visible: WARN/ERROR without service_instance from custom log source",
          "matcher": "(loglevel == \"WARN\" OR loglevel == \"ERROR\") AND isNull(service_instance)",
          "davis": {
            "properties": [
              { "key": "event.type", "value": "ERROR_EVENT" },
              { "key": "sn-event_kind", "value": "CRITICAL_LOG_EVENT" },
              { "key": "sn-environment", "value": "{sn-environment}" },
              { "key": "sn-pipeline", "value": "{sn-pipeline}" },
              { "key": "event.name", "value": "Standalone log missing service_instance on {log.source}" },
              {
                "key": "event.description",
                "value": "Custom log source did not set service_instance for {log.source} sn-event_kind=CRITICAL_LOG_EVENT sn-environment={sn-environment}: {content}"
              },
              { "key": "event.unique_identifier", "value": "{sn-environment}|enrichment-missing|{log.source}" },
              { "key": "dt.davis.is_merging_allowed", "value": "false" },
              { "key": "dt.davis.event_timeout", "value": "15m" }
            ]
          }
        }
      ]
    },
    "storage": {
      "processors": [
        {
          "id": "default-storage",
          "type": "bucketAssignment",
          "enabled": true,
          "description": "Store in default logs bucket",
          "matcher": "true",
          "bucketAssignment": { "bucketName": "default_logs" }
        }
      ]
    }
  }
}
