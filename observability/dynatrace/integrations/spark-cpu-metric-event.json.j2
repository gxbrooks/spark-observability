{
  "schemaId": "builtin:anomaly-detection.metric-events",
  "scope": "environment",
  "value": {
    "enabled": true,
    "summary": "{{ dt_sn_cpu_metric_event_summary }}",
    "queryDefinition": {
      "type": "METRIC_KEY",
      "metricKey": "builtin:host.cpu.usage",
      "aggregation": "AVG",
      "entityFilter": {
        "dimensionKey": "dt.entity.host",
        "conditions": [
          {
            "type": "HOST_GROUP_NAME",
            "operator": "EQUALS",
            "value": "{{ DT_HOST_GROUP }}"
          }
        ]
      },
      "dimensionFilter": []
    },
    "eventEntityDimensionKey": "dt.entity.host",
    "modelProperties": {
      "type": "STATIC_THRESHOLD",
      "threshold": 50.0,
      "alertOnNoData": false,
      "alertCondition": "ABOVE",
      "violatingSamples": 1,
      "samples": 3,
      "dealertingSamples": 3
    },
    "eventTemplate": {
      "title": "Host ({dims:dt.entity.host}) CPU above 50%",
      "description": "Host CPU usage in management zone {{ dt_management_zone_resolved }} exceeded 50%. sn-event_kind=CPU_EVENT sn-environment={{ dt_l2i_environment }} sn-impact=2 sn-urgency=2",
      "eventType": "RESOURCE",
      "davisMerge": true,
      "metadata": [
        { "metadataKey": "sn-event_kind", "metadataValue": "CPU_EVENT" },
        { "metadataKey": "sn-environment", "metadataValue": "{{ dt_l2i_environment }}" },
        { "metadataKey": "sn-impact", "metadataValue": "2" },
        { "metadataKey": "sn-urgency", "metadataValue": "2" }
      ]
    }
  }
}
