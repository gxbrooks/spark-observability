apiVersion: dynatrace.com/v1beta6
kind: DynaKube
metadata:
  name: dynakube
  namespace: dynatrace
  annotations:
    # Required for Kubernetes API monitoring / cluster inventory in Dynatrace UI.
    feature.dynatrace.com/automatic-kubernetes-api-monitoring: "true"
    feature.dynatrace.com/automatic-kubernetes-api-monitoring-cluster-name: "{{ K8S_DYNATRACE_CLUSTER }}"
spec:
  apiUrl: "{{ DT_API_URL }}"
  tokens: dynakube
  oneAgent:
    cloudNativeFullStack:
      args:
        - "--set-host-group={{ DT_HOST_GROUP }}"
        - "--set-host-property=Project=spark-observability"
        - "--set-host-property=Environment={{ DT_ENVIRONMENT }}"
        - "--set-host-property=OwnedBy={{ DT_OWNED_BY }}"
      # Per-node servicenow.com/service-instance labels are applied by
      # label_oneagent_servicenow.yml (shared DynaKube labels cannot vary by node).
  activeGate:
    capabilities:
      - routing
      - kubernetes-monitoring
      - dynatrace-api
      - metrics-ingest
  metadataEnrichment:
    enabled: true
  # OneAgent Log module: autodiscover container stdout/stderr (log.source=Container Output).
  # Required for Cluster Mode Spark app logs after log4j2-cluster Console appender.
  logMonitoring: {}
