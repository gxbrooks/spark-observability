{
  "schemaId": "builtin:openpipeline.logs.pipelines",
  "scope": "environment",
  "value": {
    "displayName": "{{ dt_sn_spark_openpipeline_pipeline_display_name }}",
    "customId": "{{ dt_sn_spark_openpipeline_pipeline_custom_id }}",
    "routing": "routable",
    "groupRole": "memberPipeline",
    "processing": {
      "processors": [
        {
          "id": "extract-spark-client-from-path",
          "type": "dql",
          "enabled": true,
          "description": "Parse spark-client instance from spark.log.path when enrichment missed it",
          "matcher": "isNull(spark.client.instance) AND matchesValue(spark.log.path, \"/mnt/spark/logs/spark-client/*\")",
          "dql": {
            "script": "parse spark.log.path, \"LD '/mnt/spark/logs/spark-client/' LD:spark.client.instance LD '/spark-app'\" | fieldsAdd spark.application = \"spark-client\""
          }
        },
        {
          "id": "ensure-spark-application-client",
          "type": "fieldsAdd",
          "enabled": true,
          "description": "Client-mode logical application id for Davis matchers and SN path resolution",
          "matcher": "isNotNull(spark.client.instance) OR matchesValue(spark.log.path, \"/mnt/spark/logs/spark-client/*\") OR matchesValue(log.source, \"/mnt/spark/logs/spark-client/*\")",
          "fieldsAdd": {
            "fields": [
              { "name": "spark.application", "value": "spark-client" }
            ]
          }
        },
        {
          "id": "resolve-spark-client-entity",
          "type": "fieldsAdd",
          "enabled": true,
          "description": "Bind client-mode logs to CUSTOM_DEVICE Spark Client (fieldsAdd is static-only; keeps clients off HOST so they do not bundle with service-side)",
          "matcher": "spark.application == \"spark-client\" OR isNotNull(spark.client.instance)",
          "fieldsAdd": {
            "fields": [
              {
                "name": "dt.source_entity",
                "value": "{{ dt_spark_client_custom_device_entity_id | mandatory }}"
              }
            ]
          }
        },
        {
          "id": "extract-k8s-pod-from-enriched-path",
          "type": "dql",
          "enabled": true,
          "description": "Parse pod name from spark.log.path for service-side when k8s.pod_name missing",
          "matcher": "isNull(k8s.pod_name) AND isNotNull(spark.log.path) AND spark.application != \"spark-client\" AND NOT matchesValue(spark.log.path, \"/mnt/spark/logs/spark-client/*\")",
          "dql": {
            "script": "parse spark.log.path, \"LD '/mnt/spark/logs/' LD:k8s.pod_name LD '/spark-app'\" | parse spark.log.path, \"LD '/opt/spark/logs/' LD:k8s.pod_name LD '/spark-app'\" | fieldsAdd spark.application = k8s.pod_name"
          }
        },
        {
          "id": "extract-k8s-pod-from-log-source",
          "type": "dql",
          "enabled": true,
          "description": "Parse pod name from literal log.source (fallback when spark.log.path absent)",
          "matcher": "isNull(k8s.pod_name) AND spark.application != \"spark-client\" AND isNull(spark.client.instance) AND (matchesValue(log.source, \"/mnt/spark/logs/*\") OR matchesValue(log.source, \"/opt/spark/logs/*\")) AND NOT matchesValue(log.source, \"/mnt/spark/logs/spark-client/*\")",
          "dql": {
            "script": "parse log.source, \"LD '/mnt/spark/logs/' LD:k8s.pod_name LD '/spark-app.log'\" | parse log.source, \"LD '/opt/spark/logs/' LD:k8s.pod_name LD '/spark-app.log'\" | fieldsAdd spark.application = k8s.pod_name"
          }
        },
        {
          "id": "ensure-spark-application-from-pod",
          "type": "dql",
          "enabled": true,
          "description": "Service-side: spark.application mirrors k8s.pod_name when still unset",
          "matcher": "isNull(spark.application) AND isNotNull(k8s.pod_name)",
          "dql": {
            "script": "fieldsAdd spark.application = k8s.pod_name"
          }
        },
        {
          "id": "drop-legacy-chapter-log-paths",
          "type": "drop",
          "enabled": true,
          "description": "Exclude legacy host-chapter log directories (replaced by /mnt/spark/logs/spark-client/)",
          "matcher": "matchesValue(k8s.pod_name, \"*-chapter\") OR matchesValue(spark.application, \"*-chapter\")"
        }
      ]
    },
    "davis": {
      "processors": [
        {
          "id": "spark-client-warn-error-davis",
          "type": "davis",
          "enabled": true,
          "description": "Spark client-mode driver ERROR/WARN logs (no Davis merge across drivers)",
          "matcher": "(loglevel == \"WARN\" OR loglevel == \"ERROR\") AND spark.application == \"spark-client\"",
          "davis": {
            "properties": [
              { "key": "event.type", "value": "ERROR_EVENT" },
              { "key": "event.name", "value": "Application log {loglevel} on spark-client-{spark.client.instance}" },
              {
                "key": "event.description",
                "value": "Application {loglevel} on {spark.log.path}: {content}"
              },
              { "key": "dt.source_entity", "value": "{dt.source_entity}" },
              { "key": "event.unique_identifier", "value": "spark-client-{spark.client.instance}" },
              { "key": "dt.davis.is_merging_allowed", "value": "false" },
              { "key": "dt.davis.event_timeout", "value": "15m" }
            ]
          }
        },
        {
          "id": "k8s-warn-error-davis",
          "type": "davis",
          "enabled": true,
          "description": "Kubernetes pod ERROR/WARN logs (no Davis merge across spark.application / pods)",
          "matcher": "(loglevel == \"WARN\" OR loglevel == \"ERROR\") AND isNotNull(spark.application) AND spark.application != \"spark-client\" AND (matchesValue(log.source, \"/mnt/spark/logs/*\") OR matchesValue(log.source, \"/opt/spark/logs/*\") OR matchesValue(spark.log.path, \"/mnt/spark/logs/*\") OR matchesValue(spark.log.path, \"/opt/spark/logs/*\"))",
          "davis": {
            "properties": [
              { "key": "event.type", "value": "ERROR_EVENT" },
              { "key": "event.name", "value": "Application log {loglevel} on {spark.application}" },
              {
                "key": "event.description",
                "value": "Application {loglevel} on {spark.log.path}: {content}"
              },
              { "key": "dt.source_entity", "value": "{dt.source_entity}" },
              { "key": "event.unique_identifier", "value": "{spark.application}" },
              { "key": "dt.davis.is_merging_allowed", "value": "false" },
              { "key": "dt.davis.event_timeout", "value": "15m" }
            ]
          }
        }
      ]
    },
    "storage": {
      "processors": [
        {
          "id": "default-storage",
          "type": "bucketAssignment",
          "enabled": true,
          "description": "Store in default logs bucket",
          "matcher": "true",
          "bucketAssignment": { "bucketName": "default_logs" }
        }
      ]
    }
  }
}
