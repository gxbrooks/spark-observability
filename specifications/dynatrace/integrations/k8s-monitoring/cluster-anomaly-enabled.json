{
  "schemaId": "builtin:anomaly-detection.kubernetes.cluster",
  "scope": "environment",
  "value": {
    "readinessIssues": {
      "enabled": true,
      "configuration": {
        "samplePeriodInMinutes": 2,
        "observationPeriodInMinutes": 2
      }
    },
    "cpuRequestsSaturation": {
      "enabled": true,
      "configuration": {
        "threshold": 40,
        "samplePeriodInMinutes": 3,
        "observationPeriodInMinutes": 3
      }
    },
    "memoryRequestsSaturation": {
      "enabled": true,
      "configuration": {
        "threshold": 50,
        "samplePeriodInMinutes": 3,
        "observationPeriodInMinutes": 3
      }
    },
    "podsSaturation": {
      "enabled": true,
      "configuration": {
        "threshold": 60,
        "samplePeriodInMinutes": 2,
        "observationPeriodInMinutes": 2
      }
    },
    "monitoringIssues": {
      "enabled": true,
      "configuration": {
        "samplePeriodInMinutes": 10,
        "observationPeriodInMinutes": 10
      }
    }
  }
}
