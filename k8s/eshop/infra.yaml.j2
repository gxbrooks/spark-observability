# eShop backing services: PostgreSQL (pgvector), Valkey (Redis-protocol cache) and RabbitMQ.
# All pinned to the data node (Lab2); Lab3 carries no load-bearing components.
# Credentials come from Secret eshop-credentials, created by tasks/apply-identities.yml.
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ eshop_namespace }}
  labels:
    app.kubernetes.io/part-of: eshop
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: postgres-init
  namespace: {{ eshop_namespace }}
data:
  01-databases.sql: |
    CREATE DATABASE catalogdb;
    CREATE DATABASE identitydb;
    CREATE DATABASE orderingdb;
    CREATE DATABASE webhooksdb;
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: postgres
  namespace: {{ eshop_namespace }}
  labels: {app: postgres, app.kubernetes.io/part-of: eshop}
spec:
  replicas: 1
  strategy: {type: Recreate}
  selector: {matchLabels: {app: postgres}}
  template:
    metadata:
      labels: {app: postgres, app.kubernetes.io/part-of: eshop}
    spec:
      nodeSelector: {kubernetes.io/hostname: {{ eshop_data_node }}}
      containers:
        - name: postgres
          image: pgvector/pgvector:0.8.1-pg17
          ports: [{name: postgres, containerPort: 5432}]
          env:
            - {name: POSTGRES_USER, value: postgres}
            - name: POSTGRES_PASSWORD
              valueFrom: {secretKeyRef: {name: eshop-credentials, key: postgres-password}}
            - {name: PGDATA, value: /var/lib/postgresql/data/pgdata}
          readinessProbe:
            exec: {command: [pg_isready, -U, postgres]}
            periodSeconds: 10
          resources:
            requests: {cpu: 100m, memory: 256Mi}
            limits: {memory: 1Gi}
          volumeMounts:
            - {name: data, mountPath: /var/lib/postgresql/data}
            - {name: init, mountPath: /docker-entrypoint-initdb.d}
      volumes:
        # Node-local so data survives pod restarts; eShop re-seeds if the directory is wiped.
        - name: data
          hostPath: {path: /var/lib/eshop/postgres, type: DirectoryOrCreate}
        - name: init
          configMap: {name: postgres-init}
---
apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: {{ eshop_namespace }}
spec:
  selector: {app: postgres}
  ports: [{name: postgres, port: 5432, targetPort: postgres}]
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: redis
  namespace: {{ eshop_namespace }}
  labels: {app: redis, app.kubernetes.io/part-of: eshop}
spec:
  replicas: 1
  selector: {matchLabels: {app: redis}}
  template:
    metadata:
      labels: {app: redis, app.kubernetes.io/part-of: eshop}
    spec:
      nodeSelector: {kubernetes.io/hostname: {{ eshop_data_node }}}
      containers:
        - name: valkey
          image: valkey/valkey:8.1-alpine
          ports: [{name: redis, containerPort: 6379}]
          readinessProbe:
            tcpSocket: {port: redis}
            periodSeconds: 10
          resources:
            requests: {cpu: 50m, memory: 64Mi}
            limits: {memory: 256Mi}
---
apiVersion: v1
kind: Service
metadata:
  name: redis
  namespace: {{ eshop_namespace }}
spec:
  selector: {app: redis}
  ports: [{name: redis, port: 6379, targetPort: redis}]
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: rabbitmq
  namespace: {{ eshop_namespace }}
  labels: {app: rabbitmq, app.kubernetes.io/part-of: eshop}
spec:
  replicas: 1
  strategy: {type: Recreate}
  selector: {matchLabels: {app: rabbitmq}}
  template:
    metadata:
      labels: {app: rabbitmq, app.kubernetes.io/part-of: eshop}
      # Dynatrace "Monitor annotated Prometheus exporters" scrapes RabbitMQ's built-in exporter.
      # /metrics/per-object carries per-queue series (rabbitmq_queue_messages_ready/_unacked,
      # rabbitmq_queue_consumers, labels vhost+queue); plain /metrics is aggregated only.
      annotations:
        metrics.dynatrace.com/scrape: "true"
        metrics.dynatrace.com/port: "15692"
        metrics.dynatrace.com/path: /metrics/per-object
    spec:
      nodeSelector: {kubernetes.io/hostname: {{ eshop_data_node }}}
      # Stable node name so the broker identity is constant across pod restarts.
      hostname: rabbitmq
      containers:
        - name: rabbitmq
          image: rabbitmq:4.1-management
          ports:
            - {name: amqp, containerPort: 5672}
            - {name: management, containerPort: 15672}
            - {name: prometheus, containerPort: 15692}
          env:
            - name: RABBITMQ_DEFAULT_USER
              valueFrom: {secretKeyRef: {name: eshop-credentials, key: rabbitmq-user}}
            - name: RABBITMQ_DEFAULT_PASS
              valueFrom: {secretKeyRef: {name: eshop-credentials, key: rabbitmq-password}}
          readinessProbe:
            exec: {command: [rabbitmq-diagnostics, -q, check_port_connectivity]}
            initialDelaySeconds: 20
            periodSeconds: 20
            timeoutSeconds: 15
          resources:
            requests: {cpu: 100m, memory: 256Mi}
            limits: {memory: 1Gi}
---
apiVersion: v1
kind: Service
metadata:
  name: rabbitmq
  namespace: {{ eshop_namespace }}
spec:
  selector: {app: rabbitmq}
  ports:
    - {name: amqp, port: 5672, targetPort: amqp}
    - {name: prometheus, port: 15692, targetPort: prometheus}
---
# Management UI/API, reachable from Lab hosts (and Dynatrace's RabbitMQ extension).
apiVersion: v1
kind: Service
metadata:
  name: rabbitmq-management
  namespace: {{ eshop_namespace }}
spec:
  type: NodePort
  selector: {app: rabbitmq}
  ports:
    - {name: management, port: 15672, targetPort: management, nodePort: {{ eshop_rabbitmq_mgmt_nodeport }}}
