        </mxCell>
        <mxCell id="e13" edge="1" parent="1" source="gate4" target="svc" style="endArrow=classic;html=1;strokeColor=#660066;strokeWidth=1;" value="writes svc_ci_assoc">
          <mxGeometry relative="1" as="geometry" />
