        </mxCell>
        <mxCell id="e9" edge="1" parent="1" source="gate3" target="inc" style="endArrow=classic;html=1;strokeColor=#CC6600;strokeWidth=2;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" edge="1" parent="1" source="gate3" target="ci" style="endArrow=classic;html=1;strokeWidth=1;dashed=1;exitX=0;exitY=0.7;entryX=1;entryY=0.3;" value="binds to">
          <mxGeometry relative="1" as="geometry">
