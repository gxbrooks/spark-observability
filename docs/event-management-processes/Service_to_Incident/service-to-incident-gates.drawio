        </mxCell>
        <mxCell id="note" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#990000;container=0;" value="The orange path (alert -&gt; CI) and the green path&#10;(CI -&gt; Service Instance) are independent.&#10;An alert never looks up the Service Instance;&#10;the Service Instance never gates the alert." vertex="1">
          <mxGeometry height="60" width="330" x="710" y="700" as="geometry" />
