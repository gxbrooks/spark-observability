        </mxCell>
        <mxCell id="e2b" edge="1" parent="1" source="k8s-label" target="dt-otel" style="endArrow=classic;html=1;strokeWidth=1;dashed=1;exitX=1;exitY=0.85;exitDx=0;exitDy=0;" value="pod label -&gt; Prometheus label -&gt; OTel dimension">
