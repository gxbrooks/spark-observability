        <mxCell id="e11" edge="1" parent="1" source="dt-pgi" target="gate4" style="endArrow=classic;html=1;strokeColor=#660066;strokeWidth=1;exitX=0;exitY=0.8;entryX=0.5;entryY=0;" value="entity tag read by">
